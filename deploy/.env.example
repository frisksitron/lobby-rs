# Copy to deploy/.env. Compose reads it for both services.

# The public name of the Lobby. Caddy gets a Let's Encrypt certificate for it.
LOBBY_DOMAIN=lobby.example.com

# The image compose runs. The published one is ghcr.io/<owner>/lobby-server; without this line
# compose runs the lobby-server image you built (docker build -t lobby-server:0.1.0 ...).
# LOBBY_IMAGE=ghcr.io/frisksitron/lobby-server
# Its tag. Defaults to latest.
# LOBBY_VERSION=0.1.0
