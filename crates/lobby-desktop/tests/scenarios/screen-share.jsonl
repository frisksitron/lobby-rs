{"scenario": "A Member shares a screen at up to 1440p; the other watches it at that size, stops watching; the share stops with Voice", "clients": ["a", "b"], "members": ["alice", "bob"]}
{"on": "a", "type": "{lobby}", "into": "lobby-url"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Email"}}
{"type": "alice@lobby.test", "into": "email"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Code"}, "timeout_ms": 5000}
{"type": "{code:alice@lobby.test}", "into": "code-input"}
{"wait": {"path": "/lobby/phase", "eq": "connected"}, "timeout_ms": 5000}
{"click": "voice-join"}
{"wait": {"path": "/lobby/voice/controls", "eq": "in_voice"}, "timeout_ms": 8000}
{"on": "b", "type": "{lobby}", "into": "lobby-url"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Email"}}
{"type": "bob@lobby.test", "into": "email"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Code"}, "timeout_ms": 5000}
{"type": "{code:bob@lobby.test}", "into": "code-input"}
{"wait": {"path": "/lobby/phase", "eq": "connected"}, "timeout_ms": 5000}
{"click": "voice-join"}
{"wait": {"path": "/lobby/voice/controls", "eq": "in_voice"}, "timeout_ms": 8000}
// Past the moment a click on Share Screen is taken as the end of a double-click on Join Voice.
{"on": "a", "advance": 600}
// The picker lists the synthetic test pattern (fake media) after the screens and windows.
{"on": "a", "click": "share-screen"}
{"wait": {"path": "/elements/picker-test-0", "exists": true}, "timeout_ms": 5000}
{"shot": "picker", "id": "source-picker"}
// Up to 1440p from a 4K picture: the Viewer gets 2560x1440, and the choice is remembered.
{"click": "share-quality-1440p"}
{"shot": "picker-1440p", "id": "source-picker"}
{"scroll": "source-picker-list", "to": "picker-test-3"}
{"click": "picker-test-3"}
{"wait": {"path": "/lobby/voice/share", "eq": "live"}, "timeout_ms": 8000}
{"wait": {"path": "/lobby/viewer/whose", "eq": "mine"}}
{"expect": {"path": "/settings/share_quality", "eq": "1440p"}}
{"on": "b", "wait": {"path": "/lobby/members/alice", "contains": {"sharing": true, "tile": "rest"}}}
{"click": "watch-alice"}
{"wait": {"path": "/lobby/viewer/shown", "ne": 0}}
{"expect": {"all": [{"path": "/lobby/watching", "eq": "alice"}, {"path": "/lobby/members/alice/tile", "eq": "on_screen"}, {"path": "/lobby/viewer/size", "eq": [2560, 1440]}]}}
{"shot": "watching", "id": "viewer-panel"}
{"shot": "watching-tile", "id": "voice-section"}
{"click": "watch-alice"}
{"wait": {"all": [{"path": "/lobby/watching", "eq": null}, {"path": "/lobby/viewer", "eq": null}]}}
{"click": "watch-alice"}
{"wait": {"path": "/lobby/viewer/shown", "ne": 0}}
// Leaving Voice stops one's own share, and its view; the viewer closes on the other client.
{"on": "a", "click": "voice-leave"}
{"wait": {"all": [{"path": "/lobby/sharing", "eq": null}, {"path": "/lobby/viewer", "eq": null}]}}
{"on": "b", "wait": {"all": [{"path": "/lobby/members/alice/sharing", "eq": false}, {"path": "/lobby/watching", "eq": null}]}, "timeout_ms": 2000}
