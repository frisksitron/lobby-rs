{"scenario": "The author edits and deletes their Message from its menu; the other Member sees both", "clients": ["a", "b"], "members": ["alice", "bob"]}
{"on": "a", "type": "{lobby}", "into": "lobby-url"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Email"}}
{"type": "alice@lobby.test", "into": "email"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Code"}, "timeout_ms": 5000}
{"type": "{code:alice@lobby.test}", "into": "code-input"}
{"wait": {"path": "/lobby/phase", "eq": "connected"}, "timeout_ms": 5000}
{"on": "b", "type": "{lobby}", "into": "lobby-url"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Email"}}
{"type": "bob@lobby.test", "into": "email"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Code"}, "timeout_ms": 5000}
{"type": "{code:bob@lobby.test}", "into": "code-input"}
{"wait": {"path": "/lobby/phase", "eq": "connected"}, "timeout_ms": 5000}
{"on": "a", "type": "teh cat sat on the mat", "into": "composer"}
{"press": "enter"}
{"wait": {"path": "/lobby/feed", "contains": {"author": "alice", "text": "teh cat sat on the mat", "pending": false}}}
{"on": "b", "wait": {"path": "/lobby/feed", "contains": {"text": "teh cat sat on the mat"}}, "timeout_ms": 2000}
// Another Member's Message offers no Edit or Delete.
{"right_click": "row-m1"}
{"wait": {"visible": "menu-copy-message"}}
{"expect": {"gone": "menu-edit"}}
{"expect": {"gone": "menu-delete"}}
{"press": "escape"}
// Edit puts the text in the composer; what was typed there waits and comes back.
{"on": "a", "type": "half a thought", "into": "composer"}
{"right_click": "row-m1"}
{"click": "menu-edit"}
{"wait": {"path": "/lobby/composer_editing", "eq": true}}
{"expect": {"path": "/lobby/composer", "eq": "teh cat sat on the mat"}}
{"shot": "editing", "id": "composer"}
{"press": "escape"}
{"wait": {"path": "/lobby/composer_editing", "eq": false}}
{"expect": {"path": "/lobby/composer", "eq": "half a thought"}}
{"press": "ctrl-a"}
{"press": "backspace"}
// Up in an empty composer edits the newest own Message; Enter saves it.
{"press": "up"}
{"wait": {"path": "/lobby/composer_editing", "eq": true}}
{"press": "ctrl-a"}
{"type": "the cat sat on the mat"}
{"press": "enter"}
{"wait": {"path": "/lobby/chat/rows", "contains": {"text": "the cat sat on the mat", "edited": true}}}
{"expect": {"path": "/lobby/composer", "eq": ""}}
{"expect": {"visible": "m1-edited"}}
{"on": "b", "wait": {"path": "/lobby/chat/rows", "contains": {"text": "the cat sat on the mat", "edited": true}}, "timeout_ms": 2000}
{"shot": "edited"}
{"on": "a", "right_click": "row-m1"}
{"wait": {"visible": "menu-delete"}}
{"shot": "menu", "hover": true}
{"click": "menu-delete"}
{"wait": {"path": "/lobby/feed", "len": 0}}
{"on": "b", "wait": {"path": "/lobby/feed", "len": 0}, "timeout_ms": 2000}
{"shot": "deleted"}
