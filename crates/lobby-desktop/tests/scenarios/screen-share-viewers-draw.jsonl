{"scenario": "Viewers draw on the picture with the mouse: alice lets viewers draw from her strip; bob and carol take the pen and draw at once, and dave sees two strokes in two colours with both names at their tips while each drawer sees only the other's; alice's own view paints none of it; the strokes stay full two seconds after the pens lift, fade and are gone; turning drawing off mid-stroke ends it and empties the pen's slot without moving the strip; in fullscreen a press on the letterbox draws nothing, and Esc ends a stroke before it leaves", "clients": ["a", "b", "c", "d"], "members": ["alice", "bob", "carol", "dave"]}
{"on": "a", "type": "{lobby}", "into": "lobby-url"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Email"}}
{"type": "alice@lobby.test", "into": "email"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Code"}, "timeout_ms": 5000}
{"type": "{code:alice@lobby.test}", "into": "code-input"}
{"wait": {"path": "/lobby/phase", "eq": "connected"}, "timeout_ms": 5000}
{"on": "b", "type": "{lobby}", "into": "lobby-url"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Email"}}
{"type": "bob@lobby.test", "into": "email"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Code"}, "timeout_ms": 5000}
{"type": "{code:bob@lobby.test}", "into": "code-input"}
{"wait": {"path": "/lobby/phase", "eq": "connected"}, "timeout_ms": 5000}
{"on": "c", "type": "{lobby}", "into": "lobby-url"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Email"}}
{"type": "carol@lobby.test", "into": "email"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Code"}, "timeout_ms": 5000}
{"type": "{code:carol@lobby.test}", "into": "code-input"}
{"wait": {"path": "/lobby/phase", "eq": "connected"}, "timeout_ms": 5000}
{"on": "d", "type": "{lobby}", "into": "lobby-url"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Email"}}
{"type": "dave@lobby.test", "into": "email"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Code"}, "timeout_ms": 5000}
{"type": "{code:dave@lobby.test}", "into": "code-input"}
{"wait": {"path": "/lobby/phase", "eq": "connected"}, "timeout_ms": 5000}
{"on": "a", "click": "voice-join"}
{"wait": {"path": "/lobby/voice/controls", "eq": "in_voice"}, "timeout_ms": 8000}
{"on": "b", "click": "voice-join"}
{"wait": {"path": "/lobby/voice/controls", "eq": "in_voice"}, "timeout_ms": 8000}
{"on": "c", "click": "voice-join"}
{"wait": {"path": "/lobby/voice/controls", "eq": "in_voice"}, "timeout_ms": 8000}
{"on": "d", "click": "voice-join"}
{"wait": {"path": "/lobby/voice/controls", "eq": "in_voice"}, "timeout_ms": 8000}
// Past the moment a click on Share Screen is taken as the end of a double-click on Join Voice.
{"on": "a", "advance": 600}
{"click": "share-screen"}
{"wait": {"path": "/elements/picker-test-0", "exists": true}, "timeout_ms": 5000}
{"scroll": "source-picker-list", "to": "picker-test-0"}
{"click": "picker-test-0"}
{"wait": {"path": "/lobby/voice/share", "eq": "live"}, "timeout_ms": 8000}
{"wait": {"path": "/lobby/viewer/whose", "eq": "mine"}}
{"on": "b", "wait": {"path": "/lobby/sharers", "len": 1}, "timeout_ms": 3000}
{"right_click": "member-alice"}
{"wait": {"path": "/lobby/member_panel/user", "eq": "alice"}}
{"click": "member-watch"}
{"wait": {"path": "/lobby/viewer/shown", "ne": 0}}
{"on": "c", "wait": {"path": "/lobby/sharers", "len": 1}, "timeout_ms": 3000}
{"right_click": "member-alice"}
{"wait": {"path": "/lobby/member_panel/user", "eq": "alice"}}
{"click": "member-watch"}
{"wait": {"path": "/lobby/viewer/shown", "ne": 0}}
{"on": "d", "wait": {"path": "/lobby/sharers", "len": 1}, "timeout_ms": 3000}
{"right_click": "member-alice"}
{"wait": {"path": "/lobby/member_panel/user", "eq": "alice"}}
{"click": "member-watch"}
{"wait": {"path": "/lobby/viewer/shown", "ne": 0}}
// Until alice lets viewers draw, a Viewer's pen slot is empty, and nothing moves when it fills.
{"on": "b", "expect": {"all": [{"gone": "share-pen"}, {"path": "/lobby/viewer/pen", "eq": false}, {"visible": "ink-canvas"}]}}
{"mark": "strip"}
{"on": "a", "expect": {"all": [{"visible": "share-let-draw"}, {"path": "/lobby/ink/drawing_on", "eq": false}]}}
{"click": "share-let-draw"}
{"wait": {"path": "/lobby/ink/drawing_on", "eq": true}, "timeout_ms": 3000}
{"shot": "sharer-toolbar", "id": "share-toolbar"}
{"on": "b", "wait": {"visible": "share-pen"}, "timeout_ms": 3000}
{"expect": {"all": [{"unchanged": "share-close", "since": "strip"}, {"unchanged": "share-fullscreen", "since": "strip"}, {"path": "/lobby/viewer/pen", "eq": false}]}}
// Outside drawing mode a press on the picture draws nothing.
{"pen": "down", "at": [0.3, 0.3]}
{"pen": "up"}
{"expect": {"all": [{"path": "/lobby/ink/pen_down", "eq": false}, {"path": "/lobby/ink/strokes", "len": 0}]}}
{"click": "share-pen"}
{"wait": {"path": "/lobby/viewer/pen", "eq": true}}
{"on": "c", "wait": {"visible": "share-pen"}, "timeout_ms": 3000}
{"click": "share-pen"}
{"wait": {"path": "/lobby/viewer/pen", "eq": true}}
// bob and carol draw at once, each holding the button down. bob starts on the toolbar's fade,
// beside its buttons: only the buttons take the pointer.
{"on": "b", "pen": "down", "at": [0.15, 0.04]}
{"pen": "move", "at": [0.3, 0.42]}
{"pen": "move", "at": [0.45, 0.36]}
{"on": "c", "pen": "down", "at": [0.55, 0.75]}
{"pen": "move", "at": [0.68, 0.6]}
{"pen": "move", "at": [0.8, 0.72]}
{"advance": 200}
{"on": "b", "advance": 200}
// dave sees two strokes in two colours, each Member's name at the tip of their stroke.
{"on": "d", "wait": {"all": [{"path": "/lobby/viewer/ink/strokes", "len": 2}, {"path": "/lobby/viewer/ink/tags", "len": 2}]}, "timeout_ms": 3000}
{"expect": {"all": [{"path": "/lobby/viewer/ink/strokes", "count": 1, "where": {"author": "bob", "color": "#9eb919"}}, {"path": "/lobby/viewer/ink/strokes", "count": 1, "where": {"author": "carol", "color": "#bc8fff"}}, {"visible": "ink-tag-bob"}, {"visible": "ink-tag-carol"}, {"path": "/lobby/viewer/pen", "eq": false}]}}
{"shot": "two-drawers", "id": "viewer-panel"}
// A drawer sees the other's name, never their own.
{"on": "b", "wait": {"all": [{"path": "/lobby/viewer/ink/strokes", "len": 2}, {"path": "/lobby/viewer/ink/tags", "eq": ["carol"]}]}, "timeout_ms": 3000}
{"expect": {"all": [{"gone": "ink-tag-bob"}, {"visible": "ink-tag-carol"}]}}
// The pointer stays on the picture: the button is still down.
{"shot": "bob-drawing", "id": "viewer-panel", "hover": true}
{"on": "c", "wait": {"path": "/lobby/viewer/ink/tags", "eq": ["bob"]}, "timeout_ms": 3000}
// alice's board has both strokes; her own view, inside what she captures, paints none.
{"on": "a", "wait": {"path": "/lobby/ink/strokes", "len": 2}, "timeout_ms": 3000}
{"expect": {"all": [{"path": "/lobby/viewer/whose", "eq": "mine"}, {"gone": "ink-canvas"}, {"path": "/lobby/viewer/ink/strokes", "len": 0}]}}
{"shot": "sharer-sees-no-ink", "id": "viewer-panel"}
// Pens up: the names go; the strokes stay full two seconds, fade over one, and are gone.
{"on": "b", "pen": "up"}
{"on": "c", "pen": "up"}
{"on": "d", "wait": {"all": [{"path": "/lobby/viewer/ink/tags", "len": 0}, {"path": "/lobby/viewer/ink/strokes", "len": 2}]}, "timeout_ms": 3000}
{"expect": {"all": [{"gone": "ink-tag-bob"}, {"gone": "ink-tag-carol"}]}}
{"advance": 1500}
{"expect": {"path": "/lobby/viewer/ink/strokes", "count": 2, "where": {"fade": "full"}}}
{"advance": 600}
{"expect": {"path": "/lobby/viewer/ink/strokes", "count": 2, "where": {"fade": "fading"}}}
{"shot": "fading", "id": "viewer-panel"}
{"advance": 1000}
{"expect": {"path": "/lobby/viewer/ink/strokes", "len": 0}}
// Drawing off mid-stroke ends the stroke, clears every board and empties the pen's slot; the
// strip does not move.
{"on": "b", "pen": "down", "at": [0.1, 0.8]}
{"pen": "move", "at": [0.3, 0.85]}
{"advance": 200}
{"on": "d", "wait": {"path": "/lobby/viewer/ink/strokes", "len": 1}, "timeout_ms": 3000}
{"on": "a", "click": "share-let-draw"}
{"wait": {"path": "/lobby/ink/drawing_on", "eq": false}, "timeout_ms": 3000}
{"on": "b", "wait": {"all": [{"path": "/lobby/ink/pen_down", "eq": false}, {"path": "/lobby/viewer/ink/strokes", "len": 0}, {"path": "/lobby/viewer/pen", "eq": false}, {"gone": "share-pen"}]}, "timeout_ms": 3000}
{"expect": {"all": [{"unchanged": "share-close", "since": "strip"}, {"unchanged": "share-fullscreen", "since": "strip"}]}}
{"pen": "up"}
{"on": "d", "wait": {"path": "/lobby/viewer/ink/strokes", "len": 0}, "timeout_ms": 3000}
// Back on, the pen is offered again, and drawing mode waits for bob to take it.
{"on": "a", "click": "share-let-draw"}
{"on": "b", "wait": {"visible": "share-pen"}, "timeout_ms": 3000}
{"expect": {"path": "/lobby/viewer/pen", "eq": false}}
// Fullscreen: a press on the letterbox above the picture draws nothing, one just inside does.
{"click": "share-pen"}
{"click": "share-fullscreen"}
{"wait": {"path": "/lobby/viewer/fullscreen", "eq": true}}
{"expect": {"path": "/lobby/viewer/pen", "eq": true}}
// The picture is 382 px tall in a 400 px tile: 2 % above it is 8 px into the 9 px bar.
{"pen": "down", "at": [0.5, -0.02]}
{"expect": {"all": [{"path": "/lobby/ink/pen_down", "eq": false}, {"path": "/lobby/ink/strokes", "len": 0}]}}
{"pen": "up"}
{"pen": "down", "at": [0.5, 0.03]}
{"pen": "move", "at": [0.62, 0.12]}
{"expect": {"all": [{"path": "/lobby/ink/pen_down", "eq": true}, {"path": "/lobby/viewer/ink/strokes", "len": 1}]}}
{"shot": "fullscreen-drawing", "hover": true}
// Esc ends the stroke where the pen is and stays in fullscreen; the pointer still held draws no
// more. The next Esc says how to leave, and the one after leaves.
{"press": "escape"}
{"expect": {"all": [{"path": "/lobby/ink/pen_down", "eq": false}, {"path": "/lobby/ink/strokes/0/lifted", "eq": true}, {"path": "/lobby/ink/strokes/0/points", "eq": 3}, {"path": "/lobby/viewer/fullscreen", "eq": true}, {"path": "/lobby/viewer/esc_hint", "eq": false}]}}
{"pen": "move", "at": [0.7, 0.2]}
{"expect": {"all": [{"path": "/lobby/ink/pen_down", "eq": false}, {"path": "/lobby/ink/strokes/0/points", "eq": 3}]}}
{"pen": "up"}
{"press": "escape"}
{"expect": {"path": "/lobby/viewer/esc_hint", "eq": true}}
{"press": "escape"}
{"expect": {"path": "/lobby/viewer/fullscreen", "eq": false}}
