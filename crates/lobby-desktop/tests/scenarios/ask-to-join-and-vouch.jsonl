{"scenario": "Someone asks to join, waits for a Vouch, is Vouched in from the Decision list and appears live", "clients": ["a", "b"], "members": ["alice"]}
{"on": "a", "type": "{lobby}", "into": "lobby-url"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Email"}}
{"type": "alice@lobby.test", "into": "email"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "Code"}, "timeout_ms": 5000}
{"type": "{code:alice@lobby.test}", "into": "code-input"}
{"wait": {"path": "/lobby/phase", "eq": "connected"}, "timeout_ms": 5000}
// A new email: its code leads to a name, which Asks to Join.
{"on": "b", "type": "{lobby}", "into": "lobby-url"}
{"click": "connect"}
{"wait": {"path": "/auth/step", "eq": "Email"}}
{"type": "carol.v@lobby.test", "into": "email"}
{"click": "send-code"}
{"wait": {"path": "/auth/step", "eq": "Code"}, "timeout_ms": 5000}
{"type": "{code:carol.v@lobby.test}", "into": "code-input"}
{"wait": {"path": "/auth/step", "eq": "Name"}, "timeout_ms": 5000}
{"click": "name"}
{"press": "ctrl-a"}
{"type": "carol"}
{"press": "enter"}
{"wait": {"path": "/auth/step", "eq": "AwaitingVouch"}, "timeout_ms": 5000}
{"expect": {"path": "/auth/rail", "contains": {"stage": "Name", "at": "done", "value": "carol"}}}
{"shot": "awaiting-vouch", "id": "auth"}
// alice's bell has the request; she Vouches from the Decision list.
{"on": "a", "wait": {"path": "/lobby/decisions", "contains": {"name": "carol", "settled": null}}, "timeout_ms": 3000}
{"click": "notification-bell"}
{"wait": {"visible": "vouch-carol"}, "timeout_ms": 2000}
{"shot": "decision", "id": "notification-center"}
{"click": "vouch-carol"}
{"wait": {"path": "/lobby/decisions", "contains": {"name": "carol", "settled": "VouchedIn"}}, "timeout_ms": 3000}
// carol's screen checks every 30 s and when her window comes back; "Check now" asks at once. It
// says "You're in!" for a moment and opens the Lobby; she appears on alice's list live.
{"on": "b", "click": "check-again"}
{"wait": {"path": "/lobby/phase", "eq": "connected"}, "timeout_ms": 5000}
{"expect": {"path": "/lobby/me", "eq": "carol"}}
{"on": "a", "wait": {"path": "/lobby/members/carol/presence", "eq": "online"}, "timeout_ms": 3000}
